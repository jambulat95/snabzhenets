# Скопировать в .env. Секреты в репозиторий не попадают.
POSTGRES_PASSWORD=snab
SECRET_KEY=change-me

# Демо-режим: письма только на @demo.local (CLAUDE.md, 1.6). Выключать — только для пилота с подтверждением
DEMO_MODE=true
DEMO_MAIL_DOMAIN=demo.local
MAILBOX=zakupki@demo.local

# Шлюз моделей (перенесён из A2A): порядок — первый основной, остальные резерв
LLM_PROVIDERS=yandexgpt,gigachat
# YandexGPT (AI Studio)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# GigaChat: ключ авторизации для OAuth; корневой сертификат НУЦ Минцифры уже в app/ai/gateway/certs
GIGACHAT_API_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Локальная Qwen (llama.cpp, OpenAI-совместимый API) — по желанию: добавить qwen-local в LLM_PROVIDERS
LLM_BASE_URL=
LLM_KEY=
LLM_MODEL=qwen3-14b
